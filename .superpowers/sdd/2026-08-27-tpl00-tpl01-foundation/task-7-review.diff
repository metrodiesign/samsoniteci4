+    public function testCreateAndEditUseOrderLayoutWhileListingsStayOnAdminLayout(): void
+    {
+        $admin = $this->session(1, 1, null);
+        $expectedOrderAssets = [
+            '/assets/css/style.css',
+            '/assets/js/browse/jquery.knob.js',
+            '/assets/js/browse/jquery.ui.widget.js',
+            '/assets/js/browse/jquery.iframe-transport.js',
+            '/assets/js/browse/jquery.fileupload.js',
+            '/assets/js/browse/script.js',
+        ];
+
+        foreach (['/orders/new', '/orders/91001'] as $route) {
+            $response = $this->withSession($admin)->get($route);
+            $response->assertStatus(200);
+            $body = (string) $response->getBody();
+            self::assertStringContainsString('<body class="skin-blue sidebar-mini">', $body, $route);
+
+            $offset = -1;
+            foreach ($expectedOrderAssets as $asset) {
+                $next = strpos($body, $asset);
+                self::assertNotFalse($next, $route . ' missing ' . $asset);
+                self::assertGreaterThan($offset, $next, $route . ' asset order ' . $asset);
+                $offset = $next;
+            }
+            self::assertStringNotContainsString('/assets/js/addOrder.js', $body, $route);
+        }
+
+        foreach (['/ordersListing', '/TrackingListing'] as $route) {
+            $body = (string) $this->withSession($admin)->get($route)->getBody();
+            foreach ($expectedOrderAssets as $asset) {
+                self::assertStringNotContainsString($asset, $body, $route . ' leaked ' . $asset);
+            }
+        }
+    }

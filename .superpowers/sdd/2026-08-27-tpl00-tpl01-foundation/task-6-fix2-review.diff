+/* The rule above is written for text-like inputs. A checkbox or radio caught by it renders as a
+   full-width 2.7rem box with its control floating in the middle, and the `label { display: block }`
+   above stacks every choice on its own line. CI3 draws them as small inline controls with the text
+   beside them, so both rules are undone for the two control types and for any label wrapping one. */
+input[type="checkbox"], input[type="radio"] {
+    width: auto;
+    min-height: 0;
+    padding: 0;
+    margin: 0;
+}
+label:has(> input[type="checkbox"]), label:has(> input[type="radio"]) {

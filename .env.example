# Copy to .env and fill in local-only values. Never commit .env.

# Compose identity. Must match the top-level `name:` in compose.yaml and every -p flag.
COMPOSE_PROJECT_NAME=samsonitetracking-ci4-migration

# Exact tag + digest. Never a floating tag.
MARIADB_IMAGE=mariadb:11.4.12@sha256:67873d30a17f6a9c331f06363b2fa15f38abca415529966d67c84f87f82439fe

# Host port for the DB. `dbctl.sh preflight` rewrites this to the first free port in the
# pool declared inside dbctl.sh (13306 13307 13308 18306). Loopback only, never all-interface.
DB_HOST_PORT=13306

# Local rehearsal credentials. Generate fresh values - NEVER reuse the production
# credentials from the legacy application/config/database.php.
MARIADB_DATABASE=samsonitetracking
MARIADB_USER=samsonite
MARIADB_ROOT_PASSWORD=change-me-local-only
MARIADB_PASSWORD=change-me-local-only

# Absolute path to the production dumps. Always outside this repo - never copied in.
DUMP_DIR=/absolute/path/to/samsonite_tracking_20260731/database

# CI3 rehearsal image, built locally by `dbctl.sh web-build` (not pulled from a registry)
CI3_WEB_IMAGE=samsonitetracking-ci3:8dad4e3
# Pinned, read-only CI3 source used as the build context
CI3_SOURCE_ROOT=/absolute/path/to/samsoniteci3
# Web port. PORT-CI4-LOCAL-001 reserves 18404 with fallbacks 18405-18419.
WEB_HOST_PORT=18404

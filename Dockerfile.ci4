# syntax=docker/dockerfile:1
FROM composer:2.8.11@sha256:68e926a477000f12e8645e82a020b84904d49071c895c4951551fe80eed5d103 AS composer

FROM php:8.5.7-cli-bookworm@sha256:1ff2cdf2754bcac61128bfda455d418639c0f45a8b1583b4b90f9873a2ba1368

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends libicu-dev libonig-dev libzip-dev libpng-dev libjpeg62-turbo-dev nodejs; \
    docker-php-ext-configure gd --with-jpeg; \
    docker-php-ext-install -j"$(nproc)" intl mbstring mysqli zip gd; \
    rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-interaction --no-progress --prefer-dist

COPY --chown=www-data:www-data app app
COPY --chown=www-data:www-data public public
COPY --chown=www-data:www-data tests/ci4 tests/ci4
COPY --chown=www-data:www-data tests/wp00c/ci4-route-disposition.json tests/wp00c/ci4-route-disposition.json
COPY --chown=www-data:www-data writable writable
COPY --chown=www-data:www-data spark spark
COPY --chown=www-data:www-data scripts/ci4-server-rewrite.php scripts/ci4-server-rewrite.php
COPY --chown=www-data:www-data phpunit.xml.dist phpunit.xml.dist

USER www-data

EXPOSE 8080

CMD ["php", "-S", "0.0.0.0:8080", "-t", "public", "scripts/ci4-server-rewrite.php"]

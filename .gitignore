.env
.env.*
!.env.example

# production dump ห้ามเข้า repo เด็ดขาด (PII)
*.sql
# Generated only after privacy-purge validates that it has DDL and zero data rows.
!db/local-schema-only.sql

# evidence และ lock เก็บ local เท่านั้น
evidence/
.dbctl.lock/

# Local Python validation artifacts
__pycache__/
*.py[cod]

# CodeIgniter 4 generated dependencies and runtime output
/vendor/
/build/
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
/writable/uploads/*
!/writable/cache/index.html
!/writable/debugbar/index.html
!/writable/logs/index.html
!/writable/session/index.html
!/writable/uploads/index.html

# Agent pipeline scratch (handoff docs, never part of the codebase)
/.pipeline/
/.playwright-mcp/
